{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/capability.schema.json",
  "title": "Domain Capability Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain_id", "capabilities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "domain_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "task_types", "workflows", "skills", "tools", "evaluators", "permissions", "dependencies"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "task_types": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "workflows": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "evaluators": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "permissions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
