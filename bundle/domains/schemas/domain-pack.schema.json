{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/domain-pack.schema.json",
  "title": "Domain Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "description", "version", "status", "owner", "inherits", "applicability", "compatibility", "activation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "enum": ["draft", "active", "deprecated", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "inherits": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_types", "repository_signals"],
      "properties": {
        "task_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "repository_signals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_protocol_version", "statement"],
      "properties": {
        "kernel_protocol_version": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence"],
      "properties": {
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
