{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain Owners",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain_id", "primary_owner", "reviewers"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "domain_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "primary_owner": { "type": "string", "minLength": 1 },
    "reviewers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
