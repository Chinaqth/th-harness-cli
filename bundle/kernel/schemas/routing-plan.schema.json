{
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status",
    "message",
    "source_revision",
    "selections",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "matched",
        "no_match",
        "source_error"
      ]
    },
    "message": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain_id",
          "version",
          "route_id",
          "capability_ids",
          "reason",
          "stages"
        ],
        "properties": {
          "domain_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "stages": {
            "type": "object",
            "required": [
              "prepare",
              "execute",
              "evaluate",
              "summarize"
            ]
          }
        }
      }
    },
    "issues": {
      "type": "array"
    }
  }
}
