{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "intent", "task_class", "task_type", "operation", "deliverables", "constraints", "repository_signals", "affected_surfaces", "required_evidence"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "task_class": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["inspect", "create", "modify", "remove", "publish", "operate"] },
    "deliverables": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "repository_signals": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "affected_surfaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "current_behavior": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "expected_behavior": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "permission_hints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "external_effects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "required_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "risk_hints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
