{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Protocol Version Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "kernel_protocol_version", "contracts", "domain_compatibility"],
  "properties": {
    "manifest_schema_version": { "const": "1.0" },
    "kernel_protocol_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_pack_source", "task_envelope", "routing_plan", "approval_decisions", "task_workflow_registry", "project_domain_overlay", "domain_pack", "domain_registry"],
      "properties": {
        "domain_pack_source": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "task_envelope": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "routing_plan": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "approval_decisions": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "task_workflow_registry": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "project_domain_overlay": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "domain_pack": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "domain_registry": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "domain_compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kernel_protocol_version", "domain_pack_contract_version", "domain_registry_version", "status"],
        "properties": {
          "kernel_protocol_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "domain_pack_contract_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "domain_registry_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "status": { "enum": ["supported", "deprecated"] }
        }
      }
    }
  }
}
