{
  "type": "object",
  "required": [
    "schema_version",
    "sources",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "repository",
          "ref",
          "registry",
          "required_kernel_protocol_version"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "([0-9a-f]{40}|sha256:[0-9a-f]{64})"
          },
          "required_kernel_protocol_version": {
            "const": "4.0"
          }
        }
      }
    }
  }
}
