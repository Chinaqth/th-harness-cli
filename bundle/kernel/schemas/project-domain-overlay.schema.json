{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Domain Overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domains"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "enabled", "local_owner", "additional_signals", "constraints", "disabled_capabilities", "mappings"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "enabled": { "type": "boolean" },
          "local_owner": { "type": "string", "minLength": 1 },
          "additional_signals": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "disabled_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capability_id", "project_paths", "commands"],
              "properties": {
                "capability_id": { "type": "string", "minLength": 1 },
                "project_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "commands": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              }
            }
          }
        }
      }
    }
  }
}
