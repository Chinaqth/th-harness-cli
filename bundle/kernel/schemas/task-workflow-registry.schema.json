{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Kernel Task Workflow Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflows"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "description", "task_classes", "governing_workflow", "stages", "approval_policy"],
        "properties": {
          "id": { "type": "string", "pattern": "^task\\.[a-z0-9][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "description": { "type": "string", "minLength": 1 },
          "task_classes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "governing_workflow": { "type": "string", "minLength": 1 },
          "stages": { "type": "array", "minItems": 1, "items": { "enum": ["assess", "propose", "approve", "implement", "verify", "evaluate", "deliver", "institutionalize"] }, "uniqueItems": true },
          "approval_policy": { "enum": ["risk-proportional", "always-before-implementation"] }
        }
      }
    }
  }
}
